+def snapshot_generated(generated_root: Path) -> dict[Path, float]:
+    """PNG files already present under generated_root, with their modification time."""
+    if not generated_root.is_dir():
+        return {}
+    known: dict[Path, float] = {}
+    for candidate in generated_root.rglob("*.png"):
+        try:
+            if candidate.is_file() and not candidate.is_symlink():
+                known[candidate.resolve()] = candidate.stat().st_mtime
+        except OSError:
+            continue
+    return known
+
+
+def recover_generated_paths(
+    generated_root: Path, before: dict[Path, float], started_at: float, limit: int
+) -> list[Path]:
+    """Fallback: PNG files that appeared under generated_root during this run.
+
+    Codex CLI 0.162 does not always honour `--output-schema`: the image is
+    generated, but the last message does not contain the expected path. Rather
+    than failing on a successful generation, the file is recovered by its date.
+    The guarantees that matter are kept: the file must live under
+    generated_root, be a real PNG, and have appeared after the launch.
+
+    Limit: files are identified by date, so two simultaneous runs could swap
+    images. Run batches sequentially (`--workers 1`, one plan at a time).
+    """
+    if not generated_root.is_dir():
+        return []
+    fresh: list[tuple[float, Path]] = []
+    for candidate in generated_root.rglob("*.png"):
+        try:
+            if not candidate.is_file() or candidate.is_symlink():
+                continue
+            resolved = candidate.resolve()
+            resolved.relative_to(generated_root)
+            mtime = resolved.stat().st_mtime
+        except (OSError, ValueError):
+            continue
+        if resolved in before and before[resolved] >= mtime:
+            continue
+        if mtime + 1.0 < started_at:
+            continue
+        try:
+            with resolved.open("rb") as file:
+                if file.read(8) != b"\x89PNG\r\n\x1a\n":
+                    continue
+        except OSError:
+            continue
+        fresh.append((mtime, resolved))
+    fresh.sort()
+    return [path for _, path in fresh[-limit:]]
+
+
